# =============================================================================
#  .env - Secrets du projet (à copier en ".env" puis remplir)
# -----------------------------------------------------------------------------
#      cp .env.example .env
#
#  Ce fichier n'est JAMAIS commité (il est dans .gitignore).
#  setup.sh envoie les secrets "CI" ci-dessous dans les secrets GitHub Actions
#  du repo (Settings > Secrets and variables > Actions), où les workflows les
#  lisent. Une fois envoyés, le fichier .env peut être supprimé : finalize.sh
#  le supprime.
#
#  Laissez vide ce qui ne vous concerne pas : rien n'est envoyé pour une
#  valeur vide.
# =============================================================================

# --- Usage local uniquement (jamais envoyé) -----------------------------------

# Jeton GitHub utilisé par les scripts. Facultatif si vous êtes déjà connecté
# avec "gh auth login". Droits nécessaires : administration du repo.
GH_TOKEN=

# --- Secrets CI (envoyés dans GitHub Actions) ---------------------------------

# Registre privé de l'image de base (si PRIVATE_REGISTRY est renseigné dans
# CONFIGURATION.md). Utilisez un compte de service en lecture seule.
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# Valeur de l'en-tête d'authentification du scan DAST (si DAST_AUTH_HEADER est
# renseigné dans CONFIGURATION.md), ex : "Bearer eyJ...". Utilisez un compte de
# TEST dédié, jamais un compte réel.
DAST_AUTH_HEADER_VALUE=
